<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色主题下状态栏使用浅色图标；原生外壳与内嵌客户端保持一致。 -->
    <style name="Theme.LemonCode" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/foreground_subtle</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- iOS 观感：弹窗不再使用 Material 默认的方角与高对比边框。 -->
        <item name="android:alertDialogTheme">@style/Theme.LemonCode.Dialog</item>
    </style>

    <style name="Theme.LemonCode.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/foreground_subtle</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
    </style>

    <style name="Text.LemonCode" parent="">
        <item name="android:textSize">@dimen/text_ui_base</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="Text.LemonCode.Title">
        <item name="android:textSize">@dimen/text_ui_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.LemonCode.Secondary">
        <item name="android:textSize">@dimen/text_ui_sm</item>
        <item name="android:textColor">@color/foreground_subtle</item>
    </style>
    <style name="Text.LemonCode.Section">
        <item name="android:textSize">@dimen/text_ui_caption</item>
        <item name="android:textColor">@color/foreground_subtle</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- iOS 填充按钮：白底黑字、14dp 连续圆角、50dp 触摸高度。 -->
    <style name="Button.LemonCode" parent="">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">@dimen/text_ui_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- iOS 次级按钮：深色填充 + 细描边，不再使用 Material 灰色块。 -->
    <style name="Button.LemonCode.Secondary" parent="Button.LemonCode">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Button.LemonCode.Destructive" parent="Button.LemonCode.Secondary">
        <item name="android:textColor">@color/destructive</item>
    </style>

    <!-- 分组卡片：iOS 设置页的圆角容器。 -->
    <style name="Card.LemonCode" parent="">
        <item name="android:background">@drawable/card_surface</item>
        <item name="android:padding">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
