<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LemonCode" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/foreground_subtle</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Button.LemonCode" parent="android:style/Widget.Material.Button">
        <item name="android:textSize">@dimen/text_ui_base</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>
</resources>
