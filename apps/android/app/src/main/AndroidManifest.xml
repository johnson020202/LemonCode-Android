<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫码同步：只在前台扫码页请求；拒绝后本机客户端仍可正常使用。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 应用内升级：下载完成后交给系统安装器，安装仍需用户确认。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 任务完成/失败提醒：Android 13 起需运行时授权；拒绝后应用功能不受影响。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates：任务进行中的常驻实时动态通知（非运行时权限）。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 远程控制前台保活：镜像会话期间保持进程与网络存活，避免后台被系统节流断开。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 14 起 connectedDevice 类型要求至少具备一项网络/近场权限，否则 startForeground 抛 SecurityException。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LemonCode">
        <!--
          singleTask + configChanges：重复启动或旋转只回到同一实例。
          没有 singleTask 时每次点图标都会新建 Activity，各自再拉起一个服务端；
          后启动的那个发现 31234 被占用就回退到随机端口，WebView 按 origin 隔离
          localStorage，于是用户看到的是「没有会话、没有模型」的空白页。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              OAuth 授权回调：官网 /app/oauth/login 只把 zcode:// 认作合法 redirect，
              lcode:// 是品牌迁移后的自有 scheme（旧链接仍可能用它）。
              两个都注册，否则浏览器授权完成后回不到应用。
              singleTask 保证回调复用已有实例（走 onNewIntent），不会再拉起一个服务端。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lcode" android:host="oauth" android:path="/callback" />
                <data android:scheme="zcode" android:host="oauth" android:path="/callback" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.LemonCode" />
        <!--
          小米超级岛（焦点通知）调试开关。官方接入流程 pId=2132 要求：
          正式发布需在小米开放平台申请 APP_ID 并通过审核；测试阶段把
          BUILD_TYPE_DEBUG 设为 true，系统才会接受本包的 miui.focus.param。
          没有 APP_ID 时该标记只影响系统是否显示「小米超级岛」设置项与是否
          采用焦点模板；标准实时动态（通道一）不依赖它。
        -->
        <meta-data
            android:name="com.xiaomi.xms.BUILD_TYPE_DEBUG"
            android:value="true" />
        <!--
          远程控制前台保活：只在镜像页打开期间运行。connectedDevice 类型表示
          「与已配对电脑保持连接」，Android 15 的 dataSync 六小时上限不适用。
        -->
        <service
            android:name=".MirrorKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="true" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
